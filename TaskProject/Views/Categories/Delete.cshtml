@model TaskProject.Models.Category

@{
    ViewData["Title"] = "Delete";
    bool showConfirm = Convert.ToBoolean(ViewData["IsShowConfirmAlert"]);
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Category</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Title)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Title)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        @if (showConfirm)
        {
            <input type="submit"
                   value="Delete"
                   class="btn btn-danger"
                   onclick="return IsConfirm();" />
        }
        else
        {
            <input type="submit"
                   value="Delete"
                   class="btn btn-danger" />
        }
 |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
<script>
    function IsConfirm() {
        return confirm("این دسته‌بندی در تسک‌هایی استفاده شده است. آیا مطمئن هستید؟");
    }
</script>
