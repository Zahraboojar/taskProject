@model IEnumerable<TaskProject.Models.Category>

@{
    ViewData["Title"] = "Index";
    var filter = ViewBag.Filter as TaskProject.ViewModels.CategoryFilterViewModel;
}
<form asp-action="Index" method="get">

    <div class="row mb-3">

        <!-- Title -->
        <div class="col-md-3">
            <label class="form-label"> عنوان  :</label>

            <input type="text"
                   name="Title"
                   value="@filter?.Title"
                   class="form-control"
                   placeholder="جستجوی عنوان ..." />
        </div>

    </div>


    <!-- Search Button -->

    <button type="submit"
            class="btn btn-primary">

        جستجو

    </button>

    <a asp-action="Index"
       class="btn btn-secondary">

        حذف فیلترها

    </a>

</form>
</hr>
<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                <a asp-action="Index"
                   asp-route-Title="@filter?.Title"
                   asp-route-Page="0"
                   asp-route-SortColumn="Title"
                   asp-route-SortDescending="@(filter?.SortColumn == "Title" ? !filter.SortDescending : false)">

                    @Html.DisplayNameFor(model => model.Title)

                    @if (filter?.SortColumn == "Title")
                    {
                        @(filter.SortDescending ? " ↓" : " ↑")
                    }

                </a>
            </th>
            <th>
                <a asp-action="Index"
                   asp-route-Title="@filter?.Title"
                   asp-route-Page="0"
                   asp-route-SortColumn="Description"
                   asp-route-SortDescending="@(filter?.SortColumn == "Description" ? !filter.SortDescending : false)">

                    @Html.DisplayNameFor(model => model.Description)

                    @if (filter?.SortColumn == "Description")
                    {
                        @(filter.SortDescending ? " ↓" : " ↑")
                    }

                </a>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

<nav>

    <ul class="pagination">

        @for (int i = 0; i < filter?.TotalPages; i++)
        {

            <li class="page-item @(i == filter?.Page ? "active" : "")">

                <a class="page-link"
                   asp-action="Index"
                   asp-route-Title="@filter?.Title"
                   asp-route-Page="0"
                   asp-route-SortColumn="@filter?.SortColumn"
                   asp-route-SortDescending="@filter?.SortDescending">

                    @(i + 1)

                </a>

            </li>

        }

    </ul>

</nav>